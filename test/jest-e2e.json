{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@contracts/(.*)$": "<rootDir>/libs/contracts/src/$1",
    "^@messaging/(.*)$": "<rootDir>/libs/messaging/src/$1"
  }
}
