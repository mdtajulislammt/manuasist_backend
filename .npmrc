install-strategy=nested
public-hoist-pattern[]=@nestjs/*
public-hoist-pattern[]=reflect-metadata
public-hoist-pattern[]=rxjs
# Hoist so `nest start` from repo root resolves deps from dist/ (see apps/*/node_modules otherwise).
public-hoist-pattern[]=jose
public-hoist-pattern[]=openid-client
public-hoist-pattern[]=@prisma/client
public-hoist-pattern[]=@prisma/adapter-pg
public-hoist-pattern[]=pg
public-hoist-pattern[]=class-validator
public-hoist-pattern[]=class-transformer
public-hoist-pattern[]=ioredis
public-hoist-pattern[]=bullmq
public-hoist-pattern[]=@nestjs/bullmq
public-hoist-pattern[]=@nestjs/microservices
