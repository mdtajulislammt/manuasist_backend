NODE_ENV=development
# Shared infra
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Service ports
API_GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
APPLICATION_SERVICE_PORT=5002
ADMIN_SERVICE_PORT=5003
AI_INGESTION_SERVICE_PORT=5004

# Internal service URLs used by api-gateway
AUTH_SERVICE_URL=http://127.0.0.1:5001
APPLICATION_SERVICE_URL=http://127.0.0.1:5002
ADMIN_SERVICE_URL=http://127.0.0.1:5003
AI_INGESTION_SERVICE_URL=http://127.0.0.1:5004
AUTH_INTERNAL_API_KEY=dev-internal-auth-key

# Per-service databases
APPLICATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/menu_assist_application_service
AUTH_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/menu_assist_auth_service
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/menu_assist_admin_service
AI_INGESTION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/menu_assist_ai_ingestion_service

# Internal keys (match per-service .env.example files)
APPLICATION_INTERNAL_API_KEY=dev-internal-application-key
INGESTION_INTERNAL_API_KEY=dev-internal-ingestion-key
API_GATEWAY_PUBLIC_URL=http://localhost:5000
GOOGLE_VISION_API_KEY=""
OPENAI_API_KEY=

# Admin platform file storage (see apps/admin-service/.env.example)
# Public base used for application-service files such as avatars.
# Use your gateway/custom domain in production, e.g. https://menu-assist.anikstudio.com/v1/app
APPLICATION_PUBLIC_URL=http://localhost:5000/v1/app
FILE_STORAGE_LOCAL_ROOT=uploads
FILE_STORAGE_PUBLIC_URL=http://localhost:5003
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=
