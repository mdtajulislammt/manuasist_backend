{
  "name": "Menu Assist — AI-Powered Dietary Intelligence App",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "license": "UNLICENSED",
  "dependencies": {
    "@menu-assist/api-auth": "workspace:*",
    "@menu-assist/contracts": "workspace:*",
    "@menu-assist/messaging": "workspace:*",
    "@nestjs/swagger": "^11.3.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "nodemailer": "^8.0.5",
    "openid-client": "^6.1.7",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.1"
  },
  "scripts": {
    "build": "pnpm run build:gateway && pnpm run build:application && pnpm run build:auth && pnpm run build:admin && pnpm run build:ai",
    "build:api-auth": "tsc -p libs/api-auth/tsconfig.build.json",
    "build:gateway": "nest build api-gateway",
    "build:application": "pnpm run build:api-auth && nest build application-service",
    "build:auth": "nest build auth-service",
    "build:admin": "pnpm run build:api-auth && nest build admin-service",
    "build:ai": "nest build ai-ingestion-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start api-gateway",
    "start:gateway": "nest start api-gateway",
    "start:application": "nest start application-service",
    "start:auth": "nest start auth-service",
    "start:admin": "nest start admin-service",
    "start:ai": "nest start ai-ingestion-service",
    "start:dev": "nest start api-gateway --watch",
    "start:dev:gateway": "nest start api-gateway --watch",
    "start:dev:application": "pnpm run build:api-auth && nest start application-service --watch",
    "start:dev:auth": "nest start auth-service --watch",
    "start:dev:admin": "pnpm run build:api-auth && nest start admin-service --watch",
    "start:dev:ai": "nest start ai-ingestion-service --watch",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:phase1": "jest --config ./test/jest-phase1.json",
    "prisma:generate:application": "prisma generate --schema apps/application-service/prisma/schema.prisma && node scripts/patch-prisma-client-cjs.mjs apps/application-service",
    "prisma:generate:auth": "prisma generate --schema apps/auth-service/prisma/schema.prisma && node scripts/patch-prisma-client-cjs.mjs apps/auth-service",
    "prisma:generate:admin": "prisma generate --schema apps/admin-service/prisma/schema.prisma && node scripts/patch-prisma-client-cjs.mjs apps/admin-service",
    "prisma:generate:ai": "prisma generate --schema apps/ai-ingestion-service/prisma/schema.prisma",
    "prisma:generate:all": "npm run prisma:generate:application && npm run prisma:generate:auth && npm run prisma:generate:admin && npm run prisma:generate:ai",
    "prisma:migrate:auth": "pnpm --dir apps/auth-service exec prisma migrate deploy",
    "prisma:migrate:admin": "pnpm exec prisma migrate deploy --config apps/admin-service/prisma.config.ts",
    "prisma:migrate:application": "pnpm exec prisma migrate deploy --config apps/application-service/prisma.config.ts",
    "seed:auth": "pnpm run build:auth && node dist/apps/auth-service/apps/auth-service/src/seed.js",
    "seed:admin": "pnpm run build:admin && node dist/apps/admin-service/apps/admin-service/src/seed.js",
    "seed:all": "pnpm run seed:auth && pnpm run seed:admin"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps/application-service/src",
      "<rootDir>/apps/auth-service/src"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@contracts/(.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@messaging/(.*)$": "<rootDir>/libs/messaging/src/$1",
      "^@menu-assist/api-auth$": "<rootDir>/libs/api-auth/src/index.ts",
      "^@menu-assist/api-auth/(.*)$": "<rootDir>/libs/api-auth/src/$1"
    },
    "collectCoverageFrom": [
      "apps/**/*.(t|j)s",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
