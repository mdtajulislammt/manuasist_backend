ADMIN_SERVICE_PORT=5003
ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/menu_assist_admin_service
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

AUTH_JWKS_URI=http://localhost:5001/.well-known/jwks.json
AUTH_JWT_ISSUER=http://localhost:5001
AUTH_JWT_AUDIENCE=menu-assist-api

# application-service calls GET /internal/onboarding/active-flow with this header
ADMIN_INTERNAL_API_KEY=dev-internal-onboarding-key

# Dashboard analytics upstream services
AUTH_SERVICE_URL=http://127.0.0.1:5001
AUTH_INTERNAL_API_KEY=dev-internal-auth-key
APPLICATION_SERVICE_URL=http://127.0.0.1:5002
APPLICATION_INTERNAL_API_KEY=dev-internal-application-key
AI_INGESTION_SERVICE_URL=http://127.0.0.1:5004
INGESTION_INTERNAL_API_KEY=dev-internal-ingestion-key

# RevenueCat Admin API sync for subscription catalog metadata
REVENUECAT_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v2

# Seed defaults for onboarding flow
ADMIN_SEED_FLOW_NAME=default-onboarding-flow
ADMIN_SEED_FLOW_VERSION=1

# Platform file storage (local VPS disk vs S3)
FILE_STORAGE_LOCAL_ROOT=uploads
FILE_STORAGE_PUBLIC_URL=http://localhost:5003
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN/public base for S3 objects (if unset, files are streamed via admin GET routes)
AWS_S3_PUBLIC_BASE_URL=
