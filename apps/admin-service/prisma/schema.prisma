generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OnboardingFlowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AppLaunchContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AppLaunchAssetKind {
  SPLASH
  INTRO_SLIDE
}

enum StorageProvider {
  LOCAL
  S3
}

enum StoredFileNamespace {
  ONBOARDING_ICON
  MENU_SCAN
  DISH_IMAGE
  LOGO
  SPLASH
  INTRO_IMAGE
  USER_AVATAR
  GENERIC
}

enum SubscriptionPlanStatus {
  ACTIVE
  ARCHIVED
}

enum SubscriptionPriceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubscriptionBillingInterval {
  WEEK
  MONTH
  YEAR
}

enum RevenueCatSyncStatus {
  SUCCESS
  FAILED
  NEEDS_STORE_SETUP
  SKIPPED
}

enum ReferralOfferStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PlatformStorageSettings {
  id             String          @id @default("default")
  activeProvider StorageProvider @default(LOCAL) @map("active_provider")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("platform_storage_settings")
}

model StoredFile {
  id          String              @id @default(uuid()) @db.Uuid
  storedName  String              @unique @map("stored_name")
  namespace   StoredFileNamespace
  provider    StorageProvider
  contentType String              @map("content_type")
  sizeBytes   Int                 @map("size_bytes")
  objectKey   String              @map("object_key")
  displayName String?             @map("display_name")
  createdAt   DateTime            @default(now()) @map("created_at")

  launchAssets AppLaunchAsset[]

  @@unique([namespace, storedName])
  @@index([namespace])
  @@map("stored_files")
}

model AppLaunchContentBundle {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String
  status      AppLaunchContentStatus @default(DRAFT)
  isActive    Boolean                @default(false) @map("is_active")
  publishedAt DateTime?              @map("published_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  assets AppLaunchAsset[]

  @@index([status, isActive])
  @@map("admin_app_launch_content_bundles")
}

model AppLaunchAsset {
  id           String             @id @default(uuid()) @db.Uuid
  bundleId     String             @map("bundle_id") @db.Uuid
  kind         AppLaunchAssetKind
  orderIndex   Int                @map("order_index")
  title        String?
  subtitle     String?
  storedFileId String             @map("stored_file_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  bundle     AppLaunchContentBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  storedFile StoredFile             @relation(fields: [storedFileId], references: [id], onDelete: Restrict)

  @@unique([bundleId, kind, orderIndex])
  @@index([bundleId, kind, orderIndex])
  @@index([storedFileId])
  @@map("admin_app_launch_assets")
}

model OnboardingFlow {
  id          String               @id @default(uuid()) @db.Uuid
  name        String
  status      OnboardingFlowStatus @default(DRAFT)
  version     Int
  isActive    Boolean              @default(false) @map("is_active")
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  steps OnboardingStep[]

  @@unique([name, version])
  @@map("admin_onboarding_flows")
}

model OnboardingStep {
  id         String   @id @default(uuid()) @db.Uuid
  flowId     String   @map("flow_id") @db.Uuid
  orderIndex Int      @map("order_index")
  title      String
  subtitle   String?
  uiConfig   Json?    @map("ui_config")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  flow OnboardingFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, orderIndex])
  @@map("admin_onboarding_steps")
}

model SubscriptionPlan {
  id          String                 @id @default(uuid()) @db.Uuid
  planKey     String                 @unique @map("plan_key")
  displayName String                 @map("display_name")
  description String?
  features    Json?
  status      SubscriptionPlanStatus @default(ACTIVE)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  prices SubscriptionPrice[]

  @@index([status])
  @@map("admin_subscription_plans")
}

model SubscriptionPrice {
  id                      String                      @id @default(uuid()) @db.Uuid
  planId                  String                      @map("plan_id") @db.Uuid
  version                 Int
  amountMinor             Int                         @map("amount_minor")
  currency                String
  priceLabel              String                      @map("price_label")
  billingPeriodLabel      String                      @map("billing_period_label")
  interval                SubscriptionBillingInterval
  trialDays               Int?                        @map("trial_days")
  revenueCatEntitlementId String                      @map("revenuecat_entitlement_id")
  revenueCatOfferingId    String?                     @map("revenuecat_offering_id")
  revenueCatPackageId     String?                     @map("revenuecat_package_id")
  revenueCatProductIds    Json?                       @map("revenuecat_product_ids")
  effectiveFrom           DateTime?                   @map("effective_from")
  effectiveUntil          DateTime?                   @map("effective_until")
  status                  SubscriptionPriceStatus     @default(DRAFT)
  publishedAt             DateTime?                   @map("published_at")
  archivedAt              DateTime?                   @map("archived_at")
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")

  plan     SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  syncLogs RevenueCatSyncLog[]

  @@unique([planId, version])
  @@index([status, effectiveFrom])
  @@index([revenueCatEntitlementId])
  @@map("admin_subscription_prices")
}

model RevenueCatSyncLog {
  id              String               @id @default(uuid()) @db.Uuid
  priceId         String               @map("price_id") @db.Uuid
  operation       String
  status          RevenueCatSyncStatus
  requestPayload  Json?                @map("request_payload")
  responsePayload Json?                @map("response_payload")
  message         String?
  createdAt       DateTime             @default(now()) @map("created_at")

  price SubscriptionPrice @relation(fields: [priceId], references: [id], onDelete: Cascade)

  @@index([priceId, createdAt])
  @@index([status])
  @@map("admin_revenuecat_sync_logs")
}

model ReferralOffer {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  status       ReferralOfferStatus @default(DRAFT)
  isActive     Boolean             @default(false) @map("is_active")
  shareBaseUrl String?             @map("share_base_url")
  publishedAt  DateTime?           @map("published_at")
  archivedAt   DateTime?           @map("archived_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  tiers ReferralRewardTier[]

  @@index([status, isActive])
  @@map("admin_referral_offers")
}

model ReferralRewardTier {
  id              String   @id @default(uuid()) @db.Uuid
  offerId         String   @map("offer_id") @db.Uuid
  friendsRequired Int      @map("friends_required")
  rewardLabel     String   @map("reward_label")
  scanCredits     Int      @default(0) @map("scan_credits")
  premiumDays     Int      @default(0) @map("premium_days")
  sortOrder       Int      @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  offer ReferralOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, friendsRequired])
  @@unique([offerId, sortOrder])
  @@index([offerId])
  @@map("admin_referral_reward_tiers")
}
