generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OnboardingFlowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StorageProvider {
  LOCAL
  S3
}

enum StoredFileNamespace {
  ONBOARDING_ICON
  MENU_SCAN
  USER_AVATAR
  GENERIC
}

model PlatformStorageSettings {
  id             String           @id @default("default")
  activeProvider StorageProvider  @default(LOCAL) @map("active_provider")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("platform_storage_settings")
}

model StoredFile {
  id           String              @id @default(uuid()) @db.Uuid
  storedName   String              @unique @map("stored_name")
  namespace    StoredFileNamespace
  provider     StorageProvider
  contentType  String              @map("content_type")
  sizeBytes    Int                 @map("size_bytes")
  objectKey    String              @map("object_key")
  displayName  String?             @map("display_name")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@unique([namespace, storedName])
  @@index([namespace])
  @@map("stored_files")
}

model OnboardingFlow {
  id          String               @id @default(uuid()) @db.Uuid
  name        String
  status      OnboardingFlowStatus @default(DRAFT)
  version     Int
  isActive    Boolean              @default(false) @map("is_active")
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  steps OnboardingStep[]

  @@unique([name, version])
  @@map("admin_onboarding_flows")
}

model OnboardingStep {
  id         String   @id @default(uuid()) @db.Uuid
  flowId     String   @map("flow_id") @db.Uuid
  orderIndex Int      @map("order_index")
  type       String
  title      String
  subtitle   String?
  uiConfig   Json?    @map("ui_config")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  flow OnboardingFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, orderIndex])
  @@map("admin_onboarding_steps")
}
