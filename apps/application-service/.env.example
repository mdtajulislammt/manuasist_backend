APPLICATION_SERVICE_PORT=5002
APPLICATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/menu_assist_application_service
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Public base used in returned avatar URLs. Use your gateway/custom domain in production.
APPLICATION_PUBLIC_URL=http://localhost:5000/v1/app

# Validate JWTs issued by auth-service (must match JWT_ISSUER / JWT_AUDIENCE there)
AUTH_JWKS_URI=http://localhost:5001/.well-known/jwks.json
AUTH_JWT_ISSUER=http://localhost:5001
AUTH_JWT_AUDIENCE=menu-assist-api
AUTH_SERVICE_URL=http://127.0.0.1:5001
AUTH_INTERNAL_API_KEY=dev-internal-auth-key

# Server-to-server: load published onboarding flow from admin-service
ADMIN_SERVICE_URL=http://127.0.0.1:5003
ADMIN_INTERNAL_API_KEY=dev-internal-onboarding-key

# Server-to-server: ai-ingestion and other services load user dietary context
APPLICATION_INTERNAL_API_KEY=dev-internal-application-key

# Server-to-server: home screen loads scan/NAI summary from ai-ingestion-service
AI_INGESTION_SERVICE_URL=http://127.0.0.1:5004
INGESTION_INTERNAL_API_KEY=dev-internal-ingestion-key

