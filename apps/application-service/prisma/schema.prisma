generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WeightGoal {
  LOSE
  MAINTAIN
  GAIN
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  EXTRA_HOT
}

enum EntitlementStatus {
  TRIALING
  ACTIVE
  CANCELED
  EXPIRED
}

enum NotificationType {
  SYSTEM
  SCAN_PROCESSING
  SCAN_RESULT_READY
  SCAN_FAILED
  PROFILE_UPDATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_EXPIRED
  PROMOTION
  // Legacy values retained for backward compatibility with existing rows.
  SCAN_READY
  DAILY_PROGRESS
  WEEKLY_PROGRESS
  REMINDER
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationChannel {
  SOCKET
  FCM
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  RETRYING
  CANCELED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

model UserProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  fullName              String?   @map("full_name")
  avatarFileId          String?   @map("avatar_file_id") @db.Uuid
  avatarUrl             String?   @map("avatar_url")
  address               String?
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("application_user_profiles")
}

model Preferences {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @unique @map("user_id") @db.Uuid
  dietType      String?     @map("diet_type")
  calorieTarget Int?        @map("calorie_target")
  spiceLevel    SpiceLevel? @map("spice_level")
  weightGoal    WeightGoal? @map("weight_goal")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("application_preferences")
}

model UserOnboardingAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  stepKey     String   @map("step_key")
  flowVersion Int      @map("flow_version")
  value       Json     @map("value")
  answeredAt  DateTime @default(now()) @map("answered_at")

  @@unique([userId, stepKey])
  @@index([userId, answeredAt])
  @@map("application_user_onboarding_answers")
}

model UserEntitlement {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  revenueCatAppUserId String?           @map("revenuecat_app_user_id")
  entitlementKey      String            @map("entitlement_key")
  status              EntitlementStatus
  productId           String?           @map("product_id")
  periodType          String?           @map("period_type")
  planKey             String?           @map("plan_key")
  priceId             String?           @map("price_id") @db.Uuid
  priceVersion        Int?              @map("price_version")
  priceLabel          String?           @map("price_label")
  billingPeriodLabel  String?           @map("billing_period_label")
  currency            String?
  amountMinor         Int?              @map("amount_minor")
  expiresAt           DateTime?         @map("expires_at")
  grandfatheredUntil  DateTime?         @map("grandfathered_until")
  willRenew           Boolean           @default(false) @map("will_renew")
  latestEventAt       DateTime?         @map("latest_event_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([userId, entitlementKey])
  @@index([revenueCatAppUserId])
  @@index([status, expiresAt])
  @@map("application_user_entitlements")
}

model RevenueCatWebhookEvent {
  id         String   @id
  eventType  String   @map("event_type")
  userId     String?  @map("user_id") @db.Uuid
  payload    Json
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([userId])
  @@index([eventType])
  @@map("application_revenuecat_webhook_events")
}

model UserUsageCredit {
  userId                   String    @id @map("user_id") @db.Uuid
  freeScanCredits          Int       @default(0) @map("free_scan_credits")
  totalReferralScanCredits Int       @default(0) @map("total_referral_scan_credits")
  referralFriendsRewarded  Int       @default(0) @map("referral_friends_rewarded")
  premiumUntil             DateTime? @map("premium_until")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@map("application_user_usage_credits")
}

model UserNotification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  icon      String           @default("bell")
  data      Json             @default("{}")
  dedupeKey String?          @map("dedupe_key")
  readAt    DateTime?        @map("read_at")
  expiresAt DateTime?        @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([expiresAt])
  @@map("application_user_notifications")
}

model UserDeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  platform   DevicePlatform
  deviceId   String         @map("device_id")
  fcmToken   String         @map("fcm_token")
  isActive   Boolean        @default(true) @map("is_active")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  deliveries NotificationDelivery[]

  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@index([fcmToken])
  @@map("application_user_device_tokens")
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  notificationId    String                     @map("notification_id") @db.Uuid
  userId            String                     @map("user_id") @db.Uuid
  deviceTokenId     String?                    @map("device_token_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  attemptCount      Int                        @default(0) @map("attempt_count")
  nextRetryAt       DateTime?                  @map("next_retry_at")
  lastAttemptAt     DateTime?                  @map("last_attempt_at")
  sentAt            DateTime?                  @map("sent_at")
  lastError         String?                    @map("last_error")
  providerMessageId String?                    @map("provider_message_id")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  notification UserNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceToken  UserDeviceToken? @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([channel, status, nextRetryAt])
  @@index([notificationId])
  @@index([deviceTokenId])
  @@map("application_notification_deliveries")
}

model MealLogEntry {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  dishId        String   @map("dish_id") @db.Uuid
  scanId        String?  @map("scan_id") @db.Uuid
  mealDate      DateTime @map("meal_date") @db.Date
  mealSlot      MealSlot @map("meal_slot")
  portionFactor Float    @map("portion_factor")
  calories      Int
  proteinG      Float?   @map("protein_g")
  carbG         Float?   @map("carb_g")
  fatG          Float?   @map("fat_g")
  naiScore      Int      @map("nai_score")
  isAdjusted    Boolean  @default(false) @map("is_adjusted")
  loggedAt      DateTime @default(now()) @map("logged_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId, mealDate])
  @@index([userId, loggedAt])
  @@map("application_meal_log_entries")
}
