generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
  EMAIL_CHANGE
  CONTACT_CHANGE
}

model AuthUser {
  id              String    @id @default(uuid()) @db.Uuid
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  /// Unique code a user can share with others.
  /// When another user registers with this code, they get `referredById` set.
  referralCode   String?   @unique @map("referral_code")

  /// Referrer user id (if this user signed up using a referral code).
  referredById   String?   @map("referred_by_id") @db.Uuid
  referredBy     AuthUser? @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      AuthUser[] @relation("UserReferrals")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  otpTokens    AuthOtpToken[]
  identities   AuthIdentity[]
  refreshTokens AuthRefreshToken[]
  roles        UserRole[]

  @@map("auth_users")
}

/// OIDC subject bound to a user (issuer + sub unique per IdP account).
model AuthIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  issuer    String
  subject   String   @map("subject")
  email     String?
  createdAt DateTime @default(now()) @map("created_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("auth_identities")
}

model AuthRefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  /// SHA-256 hex of opaque refresh token (indexed lookup).
  tokenLookup   String    @unique @map("token_lookup")
  expiresAt     DateTime  @map("expires_at")
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user         AuthUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   AuthRefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     AuthRefreshToken[] @relation("TokenRotation")

  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_refresh_tokens")
}

model Role {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique

  users UserRole[]

  @@map("auth_roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("auth_user_roles")
}

model AuthOtpToken {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  codeHash   String     @map("code_hash")
  channel    OtpChannel
  purpose    OtpPurpose
  targetIdentifier String? @map("target_identifier")
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_otp_tokens")
}
