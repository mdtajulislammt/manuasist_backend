AUTH_SERVICE_PORT=5001
# Must match PostgreSQL. Docker Compose (this repo): user postgres, password postgres, host port 5433.
# Local Postgres installs often use a different password — set USER:PASSWORD in the URL accordingly.
AUTH_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/menu_assist_auth_service
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# RS256 key pair for access JWT (PEM). Example:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
# Then paste contents (including headers) as single-line with \n or use multiline in .env
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=menu-assist-rs256
JWT_ISSUER=http://localhost:5001
JWT_AUDIENCE=menu-assist-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_INTERNAL_API_KEY=dev-internal-auth-key

# OIDC IdP (Auth0, Keycloak, Cognito, Google, etc.)
OIDC_ISSUER=https://your-tenant.auth0.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Must match the URL your browser hits (via api-gateway): gateway /v1/auth is stripped upstream
OIDC_REDIRECT_URI=http://localhost:5000/v1/auth/oauth/callback

# OTP email delivery via Gmail (App Password)
APP_NAME=Menu Assist
GMAIL_APP_USER=
GMAIL_APP_PASSWORD=
OTP_EMAIL_FROM=

# Seed defaults (override locally as needed)
AUTH_SEED_ADMIN_EMAIL=admin@menuassist.local
AUTH_SEED_ADMIN_PASSWORD=Admin@123456
AUTH_SEED_USER_EMAIL=user@menuassist.local
AUTH_SEED_USER_PASSWORD=User@123456

APPLICATION_SERVICE_URL=http://127.0.0.1:5002
APPLICATION_INTERNAL_API_KEY=dev-internal-application-key
