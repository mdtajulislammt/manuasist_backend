AUTH_SERVICE_PORT=4001
AUTH_DATABASE_URL=postgresql://postgres:root@127.0.0.1:5433/menu_assist_auth_service
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Redis (BullMQ OTP email queue + signup/reset resend cooldown)
# Docker Compose maps Redis to host port 6380
REDIS_URL=redis://127.0.0.1:6380
SIGNUP_OTP_TTL_SECONDS=600
SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_OTP_TTL_SECONDS=600
PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS=60
CONTACT_CHANGE_OTP_TTL_SECONDS=600

# RS256 key pair for access JWT (PEM). Example:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
# Then paste contents (including headers) as single-line with \n or use multiline in .env
JWT_PRIVATE_KEY="paste-generated-private-key-pem-here"
JWT_PUBLIC_KEY="paste-generated-public-key-pem-here"

JWT_KID=menu-assist-rs256
JWT_ISSUER=http://localhost:4001
JWT_AUDIENCE=menu-assist-api
ACCESS_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_INTERNAL_API_KEY="dcb939adcfa42af24852d123ac27a3a2db828943405274a630e0b76f154e32a0"


# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add "Authorized redirect URI": http://localhost:5000/v1/auth/oauth/callback?provider=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPES=openid profile email
OAUTH_REDIRECT_URI_GOOGLE=http://localhost:5000/v1/auth/oauth/callback?provider=google

# ── Apple Sign In ─────────────────────────────────────────────────────────────
# Register at: https://developer.apple.com/account/resources/identifiers/list/serviceId
# APPLE_CLIENT_ID   = your Services ID  (e.g. com.example.menuassist.web)
# APPLE_TEAM_ID     = 10-char Team ID from Apple Developer portal
# APPLE_KEY_ID      = Key ID of the Sign In with Apple key (.p8 file)
# APPLE_PRIVATE_KEY = full content of the .p8 file (replace newlines with \n in .env)
# Callback must be registered in your Services ID config as a Return URL.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_SCOPES=name email
OAUTH_REDIRECT_URI_APPLE=http://localhost:5000/v1/auth/oauth/callback/apple

# ── Legacy generic OIDC (optional — kept for custom IdP support) ──────────────
# OIDC_ISSUER=https://your-tenant.auth0.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# OIDC_REDIRECT_URI=http://localhost:5000/v1/auth/oauth/callback


# OTP email delivery via SMTP (Office 365 STARTTLS)
APP_NAME=Menu Assist
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notify@menuassistapp.com
# Required mailbox password or app password. Empty value = OTP is not emailed.
SMTP_PASSWORD=
SMTP_FROM=notify@menuassistapp.com
# Optional display-name override, e.g. Menu Assist <notify@menuassistapp.com>
OTP_EMAIL_FROM=

AUTH_SEED_ADMIN_EMAIL=admin@menuassist.local
AUTH_SEED_ADMIN_PASSWORD=Admin@123456
# Staff admins (pnpm run seed:auth-admins)
AUTH_SEED_STAFF_ADMIN_EMAILS=dgoman@menuassistapp.com,audrey.gabriella@menuassistapp.com,andrei@abalan.ro
AUTH_SEED_STAFF_ADMIN_PASSWORD=Admin@123456
AUTH_SEED_USER_EMAIL=user@menuassist.local
AUTH_SEED_USER_PASSWORD=User@123456
# Premium test user (1-month ACTIVE entitlement via pnpm seed:application)
AUTH_SEED_PREMIUM_EMAIL=premium@menuassist.local
AUTH_SEED_PREMIUM_PASSWORD=Premium@123456

APPLICATION_SERVICE_URL=http://127.0.0.1:4002
