RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Redis (BullMQ OTP email queue + signup/reset resend cooldown)
# Docker Compose maps Redis to host port 6380
REDIS_URL=redis://127.0.0.1:6380
SIGNUP_OTP_TTL_SECONDS=600
SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_OTP_TTL_SECONDS=600
PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS=60
CONTACT_CHANGE_OTP_TTL_SECONDS=600

# RS256 key pair for access JWT (PEM). Example:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
# Then paste contents (including headers) as single-line with \n or use multiline in .env
JWT_PRIVATE_KEY="paste-generated-private-key-pem-here"
JWT_PUBLIC_KEY="paste-generated-public-key-pem-here"

JWT_KID=menu-assist-rs256
JWT_ISSUER=http://localhost:2646
JWT_AUDIENCE=menu-assist-api
ACCESS_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_TTL_SECONDS=604800
