{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/auth-service",
    "rootDir": "../..",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "resolvePackageJsonExports": false,
    "paths": {
      "jose": ["../../node_modules/jose/dist/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "generated/**/*.ts", "../../libs/contracts/src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
