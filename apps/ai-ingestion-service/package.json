{
  "name": "@menu-assist/ai-ingestion-service",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "pnpm -w run build:api-auth && pnpm -w run build:ai-pipeline && nest build ai-ingestion-service",
    "start": "nest start ai-ingestion-service",
    "start:dev": "pnpm -w run build:api-auth && pnpm -w run build:ai-pipeline && pnpm -w run prisma:generate:ai && nest start ai-ingestion-service --watch",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma && node ../../scripts/patch-prisma-client-cjs.mjs ."
  },
  "dependencies": {
    "@menu-assist/ai-pipeline": "workspace:*",
    "@menu-assist/api-auth": "workspace:*",
    "@menu-assist/contracts": "workspace:*",
    "@menu-assist/messaging": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.3.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  }
}
