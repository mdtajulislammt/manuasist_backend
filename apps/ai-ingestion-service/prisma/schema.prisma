generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("AI_INGESTION_DATABASE_URL")
}

enum MenuScanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DishCategory {
  RECOMMENDED
  CAUTION
  AVOID
}

model MenuScan {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  imageUrl  String         @map("image_url")
  status    MenuScanStatus
  scanTime  DateTime       @default(now()) @map("scan_time")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  dishes Dish[]

  @@index([userId, scanTime])
  @@map("ingestion_menu_scans")
}

model Dish {
  id            String       @id @default(uuid()) @db.Uuid
  scanId        String       @map("scan_id") @db.Uuid
  name          String
  calories      Int
  dietScore     Int          @map("diet_score")
  category      DishCategory
  allergenFlags Json?        @map("allergen_flags")
  macros        Json?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  scan MenuScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@map("ingestion_dishes")
}
